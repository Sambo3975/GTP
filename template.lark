start: header body

header: "<template \"" path "\">" NEWLINE

// Path of the file to generate
path: /[ \.a-zA-Z0-9_\/]+/

body: (block | raw_text)*

block: "<?" statement* "?>"

statement: command
      | enclosure
      | for_loop

command: (assignment
      | echo) ";"

assignment: variable "=" value

echo: "echo" value

enclosure: "{" statement* "}"

for_loop: "for" variable "=" value "," value enclosure

variable: CNAME

value: variable
      | literal
      | f_string
      | array
      | indexer

literal: STRING
      | INT

STRING: /'([^'\\]|\\.)*'/
      | /"([^"\\]|\\.)*"/

INT: /-?\d+/

f_string: "f'" (F_STRING_INNER | "{" value "}")* "'"
      | "f\"" (F_STRING_INNER_2 | "{" value "}")* "\""

F_STRING_INNER: /([^'\{\\]|\\.)+/
F_STRING_INNER_2: /([^"\{\\]|\\.)+/

array: "{" ((value ",")* value ","?)? "}"

indexer: variable "[" value "]"

// Text to be copied into generated file as-is
// This can't be a terminal because it won't be visited if it is
raw_text: /.+/ 

%import common (NEWLINE, CNAME, WS)

%ignore WS
